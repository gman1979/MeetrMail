#!/usr/bin/env python3
"""Make the box resolve its own DNS zones locally, for sandbox mode.

On a live MeetrMail, the box's domains resolve through the public internet:
the registrar's glue records point at this box's nsd, and bind9 -- the local
validating resolver every service on the box uses -- reaches nsd the long way
round, from outside.

In sandbox mode none of that exists. The domain is not delegated to this
machine, so bind9 asks the real root servers about a name they have never heard
of and gets NXDOMAIN. That breaks almost everything worth testing: Postfix
cannot look up the MX for a local domain, the control panel's status checks all
fail, SPF and DMARC verification has nothing to read.

The fix is a short circuit. For each zone nsd is authoritative for, tell bind9
to forward queries straight to nsd instead of asking the internet. bind9 keeps
resolving everything else normally, so the box can still reach the outside
world.

Two details make this work:

  * nsd binds to the box's private IP, not to loopback, because bind9 already
    has 127.0.0.1:53. So the forwarder target is PRIVATE_IP.

  * The zones are DNSSEC-signed with keys generated on this box, and no DS
    record for them exists in the real root. bind9 validates DNSSEC by default,
    so it would reject nsd's perfectly good answers as bogus. `validate-except`
    switches validation off for exactly these zones and nothing else.

This is generated from nsd's own zone list, so it stays correct as domains are
added and removed. setup/start.sh runs it after tools/dns_update, and
tools/meetrmail-mode runs it when switching modes.
"""

import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "management"))
from utils import load_environment  # noqa: E402

NAMED_LOCAL = "/etc/bind/named.conf.local"
NAMED_OPTIONS = "/etc/bind/named.conf.options"
NSD_ZONES_CONF = "/etc/nsd/nsd.conf.d/zones.conf"

BEGIN = "### BEGIN MeetrMail sandbox DNS ###"
END = "### END MeetrMail sandbox DNS ###"


def get_nsd_zones():
	"""The domains nsd is authoritative for, read from the config that
	management/dns_update.py generates."""
	if not os.path.exists(NSD_ZONES_CONF):
		return []
	with open(NSD_ZONES_CONF, encoding="utf-8") as f:
		return sorted(set(re.findall(r'^\s*name:\s*"?([^"\s]+)"?', f.read(), re.MULTILINE)))


def replace_marked_block(path, body):
	"""Replace the text between our markers in `path`, or append it. Returns
	True if the file changed."""
	original = ""
	if os.path.exists(path):
		with open(path, encoding="utf-8") as f:
			original = f.read()

	# Strip any block we wrote previously.
	stripped = re.sub(
		re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?",
		"",
		original,
		flags=re.DOTALL,
	)

	updated = stripped.rstrip("\n") + "\n" + body if body else stripped

	if updated == original:
		return False
	with open(path, "w", encoding="utf-8") as f:
		f.write(updated)
	return True


def build_forward_zones(zones, target):
	if not zones:
		return ""
	out = [BEGIN,
	       "# Generated by tools/sandbox-dns-forward. Do not edit.",
	       "# Resolve this box's own zones from the local nsd instead of the internet."]
	for zone in zones:
		out += [
			f'zone "{zone}" {{',
			"\ttype forward;",
			"\tforward only;",
			f"\tforwarders {{ {target}; }};",
			"};",
		]
	out.append(END)
	return "\n".join(out) + "\n"


def build_validate_except(zones):
	"""A validate-except statement has to live inside the options block, so this
	one is spliced in rather than appended."""
	if not zones:
		return ""
	names = "; ".join(f'"{z}"' for z in zones)
	return (
		f"\t{BEGIN}\n"
		"\t# The box signs these zones with its own keys and no DS record for them\n"
		"\t# exists in the public root, so DNSSEC validation would reject them.\n"
		f"\tvalidate-except {{ {names}; }};\n"
		f"\t{END}\n"
	)


def update_named_options(block):
	"""Insert (or remove) our validate-except statement inside bind9's options
	block. Returns True if the file changed."""
	with open(NAMED_OPTIONS, encoding="utf-8") as f:
		original = f.read()

	# Remove any block we wrote before, so this is idempotent.
	stripped = re.sub(
		r"[ \t]*" + re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n",
		"",
		original,
		flags=re.DOTALL,
	)

	if block:
		# The options block is the only one in this file, so its closing brace
		# is the last `}` at the start of a line. Insert immediately above it.
		matches = list(re.finditer(r"(?m)^\};?[ \t]*$", stripped))
		if not matches:
			msg = f"Could not find the end of the options block in {NAMED_OPTIONS}."
			raise RuntimeError(msg)
		at = matches[-1].start()
		updated = stripped[:at] + block + stripped[at:]
	else:
		updated = stripped

	if updated == original:
		return False
	with open(NAMED_OPTIONS, "w", encoding="utf-8") as f:
		f.write(updated)
	return True


def main():
	env = load_environment()
	sandbox = env.get("SANDBOX_MODE") == "1"

	zones = get_nsd_zones() if sandbox else []
	target = env.get("PRIVATE_IP") or "127.0.0.1"

	if sandbox and not zones:
		print("sandbox-dns-forward: nsd has no zones yet; nothing to do.")
		return 0

	if sandbox and target in {"127.0.0.1", "::1"}:
		# bind9 is already on loopback:53, so nsd cannot also be there and there
		# is nowhere to forward to.
		print("sandbox-dns-forward: the box has no non-loopback address, so nsd and")
		print("bind9 cannot both listen on port 53. Local DNS resolution of the box's")
		print("own domains will not work in this sandbox.")
		return 0

	changed = replace_marked_block(NAMED_LOCAL, build_forward_zones(zones, target))
	changed |= update_named_options(build_validate_except(zones))

	if not changed:
		return 0

	# Never leave bind9 with a config it will not start on.
	check = subprocess.run(["/usr/bin/named-checkconf"], capture_output=True, text=True, check=False)
	if check.returncode != 0:
		print("sandbox-dns-forward: the generated bind9 configuration is not valid:")
		print(check.stdout + check.stderr)
		return 1

	subprocess.run(["/usr/sbin/service", "bind9", "restart"], check=True)
	if zones:
		print(f"sandbox-dns-forward: resolving {len(zones)} local zone(s) via nsd at {target}.")
	else:
		print("sandbox-dns-forward: local zone forwarding removed; resolving via the internet.")
	return 0


if __name__ == "__main__":
	sys.exit(main())
